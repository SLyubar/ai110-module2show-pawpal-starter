classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class TaskType {
        <<enumeration>>
        WALK
        FEED
        MEDS
        GROOM
        OTHER
    }

    class Preferences {
    }

    class Owner {
        +String name
        +List~Pet~ pets
        +Preferences preferences
        +addPet(pet) void
        +editPet(pet) void
        +removePet(pet) void
        +getNumberOfPets() int
        +getAllTasks() List~Task~
    }

    class Pet {
        +String id
        +String name
        +int age
        +String breed
        +List~Task~ tasks
        +addTask(task) void
        +removeTask(task) void
    }

    class Task {
        +String id
        +String name
        +String description
        +int duration
        +Priority priority
        +TaskType taskType
        +Frequency frequency
        +time startTime
        +bool completed
        +time endTime
        +Pet pet
        +complete() void
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Schedule {
        +List~Task~ tasks
    }

    class Scheduler {
        +Owner owner
        +int timeAvailable
        +getTasks() List~Task~
        +sortTasks(tasks) List~Task~
        +filterTasks(pet, completed) List~Task~
        +dailyPlan(pet) String
        +schedule() Schedule
        +addTask(pet, task) void
        +removeTask(pet, task) void
    }

    Owner "1" --> "0..*" Pet : owns
    Owner "1" --> "1" Preferences : has
    Pet "1" --> "0..*" Task : needs
    Task "0..*" --> "1" Pet : for
    Task --> Priority
    Task --> TaskType
    Task --> Frequency
    Scheduler "1" --> "1" Owner : reads getAllTasks() from
    Scheduler ..> Schedule : produces
    Schedule "1" --> "0..*" Task : contains
